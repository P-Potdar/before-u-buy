LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=35
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
RAG_ENABLED=1
SEMANTIC_RETRIEVAL_ENABLED=1

# Comma-separated browser origins. Do not use *.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional API URL for a deployed frontend. Empty uses the Vite /api proxy.
VITE_API_BASE_URL=

# Optional local SQLite path. Defaults to data/beforeyoubuy.sqlite3.
# BEFOREYOUBUY_DB_PATH=data/beforeyoubuy.sqlite3

# Optional provider credential. Leave blank for manual-only product entry.
# SERPAPI_KEY=
# PRODUCT_PROVIDER_TIMEOUT_SECONDS=12
# PRODUCT_CACHE_SECONDS=900
